# ==============================================================================
# Throttle (Dynamic Autonomy Controller) Environment Configuration
# ==============================================================================

# --- KeeperHub Integration (Execution Layer) ---
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=kh_live_...
# Note: The agentic-wallet variables below are used by the original /sign flow which the
# current architecture no longer relies on for Leg 1; kept for reference/possible future use.
KEEPERHUB_ORG_ID=org_...
KEEPERHUB_SUB_ORG_ID=suborg_...
KEEPERHUB_WALLET_ADDRESS=0x...
KEEPERHUB_HMAC_SECRET=...

# --- KeeperHub Treasury Sweep Workflow (Leg 2) ---
# Deployed KeeperHub workflow ID executing the downstream treasury transfer on Base (Leg 2)
KEEPERHUB_SWEEP_WORKFLOW_ID=
# Organization Turnkey wallet funding Leg 2 sweeps directly (no private key needed; KeeperHub signs server-side)
KEEPERHUB_ORG_WALLET_ADDRESS=0x...   # org's Turnkey wallet — funds this directly, no private key needed, KeeperHub signs server-side

# --- Agent Wallet (Leg 1 — signs outbound TaskMarket payments directly) ---
# Agent operating wallet private key used to sign outbound EIP-3009 task claim payments directly on-chain (Leg 1)
AGENT_WALLET_PRIVATE_KEY=

# --- Daydreams / TaskMarket Integration ---
TASKMARKET_API_URL=https://api.taskmarket.dev
BASE_RPC_URL=https://mainnet.base.org

# --- Throttle Controller Engine ---
CONTROLLER_DB_PATH=./data/throttle.sqlite
CONTROLLER_PORT=4000
CONTROLLER_LOG_LEVEL=info
SIMULATION_MODE=false

# --- Dashboard ---
VITE_CONTROLLER_WS_URL=ws://localhost:4000/feed
VITE_CONTROLLER_API_URL=http://localhost:4000
