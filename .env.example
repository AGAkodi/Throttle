# ==============================================================================
# THROTTLE: DYNAMIC AUTONOMY CONTROLLER CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. THROTTLE CONTROLLER ENGINE & LOCAL STATE
# ------------------------------------------------------------------------------
CONTROLLER_DB_PATH=./data/throttle.sqlite   # Path to local SQLite store for policy, drift, and authority state
CONTROLLER_PORT=4000                       # Port for the Throttle telemetry & evaluation server
CONTROLLER_LOG_LEVEL=info                  # Options: debug | info | warn | error
SIMULATION_MODE=false                      # true = mock workflow execution and signing; false = live endpoints

# ------------------------------------------------------------------------------
# 2. LEG 1: TASKMARKET TASK CREATION ESCROW (AGENT OPERATING WALLET)
# ------------------------------------------------------------------------------
# [REQUIRED FOR LIVE LEG 1]
# Agent operating wallet private key used to sign outbound EIP-3009 task escrow authorizations directly on Base
AGENT_WALLET_PRIVATE_KEY=0x...
# Optional worker address override; defaults to the address derived from AGENT_WALLET_PRIVATE_KEY
AGENT_WORKER_ADDRESS=0x...
# TaskMarket REST API base URL
TASKMARKET_API_URL=https://api.taskmarket.dev

# ------------------------------------------------------------------------------
# 3. LEG 2: KEEPERHUB TREASURY SWEEP (TURNKEY ORG WALLET & MCP WORKFLOW)
# ------------------------------------------------------------------------------
# [REQUIRED FOR LIVE LEG 2]
# Confirmed treasury destination wallet on Base (sole authoritative destination in live runs)
THROTTLE_TREASURY_ADDRESS=0x9e88D37203a2a5C65e8E63040719B6D939718A9F

# KeeperHub platform API credentials
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=kh_live_...

# Deployed KeeperHub workflow ID executing the downstream treasury ERC20 transfer on Base
KEEPERHUB_SWEEP_WORKFLOW_ID=wf-treasury-sweep-01

# Organization Turnkey wallet address funding Leg 2 sweeps directly
# (KeeperHub signs server-side with Turnkey; NO private key required)
KEEPERHUB_ORG_WALLET_ADDRESS=0x...

# ------------------------------------------------------------------------------
# 4. BLOCKCHAIN RPC (BASE MAINNET)
# ------------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org      # Base mainnet JSON-RPC endpoint for on-chain receipt verification

# ------------------------------------------------------------------------------
# 5. WEB DASHBOARD & REAL-TIME TELEMETRY
# ------------------------------------------------------------------------------
VITE_CONTROLLER_API_URL=http://localhost:4000
VITE_CONTROLLER_WS_URL=ws://localhost:4000/feed

# ------------------------------------------------------------------------------
# 6. LEGACY / SUPERSEDED CONFIGURATION (REFERENCE ONLY)
# ------------------------------------------------------------------------------
# The variables below were used by the exploratory /api/agentic-wallet/sign approach,
# which was superseded by the two-leg architecture (Agent EIP-3009 + KeeperHub Sweep).
# KEEPERHUB_ORG_ID=org_...
# KEEPERHUB_SUB_ORG_ID=suborg_...
# KEEPERHUB_WALLET_ADDRESS=0x...
# KEEPERHUB_HMAC_SECRET=...
# TREASURY_ADDRESS=0x... # Use THROTTLE_TREASURY_ADDRESS above instead
