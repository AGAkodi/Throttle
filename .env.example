# ==============================================================================
# Throttle (Dynamic Autonomy Controller) Environment Configuration
# ==============================================================================

# --- KeeperHub Integration (Execution Layer) ---
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=kh_live_...
KEEPERHUB_ORG_ID=org_...
KEEPERHUB_SUB_ORG_ID=suborg_...
KEEPERHUB_WALLET_ADDRESS=0x...
KEEPERHUB_HMAC_SECRET=...

# --- Daydreams / TaskMarket Integration ---
TASKMARKET_API_URL=https://api.taskmarket.dev
BASE_RPC_URL=https://mainnet.base.org

# --- Throttle Controller Engine ---
CONTROLLER_DB_PATH=./data/throttle.sqlite
CONTROLLER_PORT=4000
CONTROLLER_LOG_LEVEL=info
SIMULATION_MODE=false

# --- Dashboard ---
VITE_CONTROLLER_WS_URL=ws://localhost:4000/feed
VITE_CONTROLLER_API_URL=http://localhost:4000
