{
  "name": "throttle-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamic Autonomy Controller for Daydreams and KeeperHub",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:scenarios": "pnpm --filter @throttle/controller test scenarios",
    "test:integration": "pnpm --filter @throttle/daydreams-adapter test:integration",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "test:execution-path": "tsx scripts/prove-execution-path.ts",
    "test:execution-path:simulate": "tsx scripts/prove-execution-path.ts --simulate",
    "dev": "node scripts/serve-root.mjs",
    "dev:frontend": "node scripts/serve-root.mjs",
    "start": "node scripts/serve-root.mjs",
    "dev:controller": "tsx scripts/run-server.ts",
    "dev:dashboard": "pnpm --filter @throttle/dashboard dev",
    "build:vercel": "node scripts/prepare-vercel.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
